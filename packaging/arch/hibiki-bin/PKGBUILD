# Maintainer: linuxmobile <linuxmobile@users.noreply.github.com>
pkgname=hibiki-bin
pkgver=0.1.5
pkgrel=1
pkgdesc="A high-fidelity keystroke and bubble visualizer for Wayland (prebuilt binary)"
arch=('x86_64' 'aarch64')
url="https://github.com/linuxmobile/hibiki"
license=('MIT')
depends=(
  'gtk4'
  'gtk4-layer-shell'
  'libxkbcommon'
  'dbus'
  'alsa-lib'
  'fontconfig'
)
optdepends=(
  'pipewire-jack: JACK audio backend'
  'jack2: JACK audio backend'
)
provides=("$pkgname" 'hibiki')
conflicts=('hibiki')

source=(
  "hibiki.desktop::$url/raw/v$pkgver/assets/hibiki.desktop"
  "hibiki.svg::$url/raw/v$pkgver/assets/hibiki.svg"
  "hibiki.metainfo.xml::$url/raw/v$pkgver/assets/hibiki.metainfo.xml"
)
source_x86_64=("hibiki-linux-x86_64::$url/releases/download/v$pkgver/hibiki-linux-x86_64")
source_aarch64=("hibiki-linux-aarch64::$url/releases/download/v$pkgver/hibiki-linux-aarch64")

sha256sums=(
  'da01c0746c15fd2e6a322ee3cc0eb302a0b01dbc770e0c712b864d5075327223'
  '1d0fa6f8edeb97da66fe2763b49d4c41409316294f484f9e75047dd65346fff2'
  '4449b86cb325f75d0cec4250596872fa4102bb8734406d6266c2173548f659e6'
)
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  install -Dm755 "$srcdir/hibiki-linux-$CARCH" "$pkgdir/usr/bin/hibiki"
  install -Dm644 "$srcdir/hibiki.desktop" \
    "$pkgdir/usr/share/applications/hibiki.desktop"
  install -Dm644 "$srcdir/hibiki.metainfo.xml" \
    "$pkgdir/usr/share/metainfo/hibiki.metainfo.xml"
  install -Dm644 "$srcdir/hibiki.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/hibiki.svg"
}
