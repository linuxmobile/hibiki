# Maintainer: linuxmobile <linuxmobile@users.noreply.github.com>
pkgname=hibiki
pkgver=0.2.0
pkgrel=1
pkgdesc="A high-fidelity keystroke and bubble visualizer for Wayland"
arch=('x86_64' 'aarch64')
url="https://github.com/linuxmobile/hibiki"
license=('MIT')
depends=(
  'gtk4'
  'gtk4-layer-shell'
  'libxkbcommon'
  'dbus'
  'alsa-lib'
  'fontconfig'
)
makedepends=(
  'cargo'
  'pkgconf'
  'jack'
)
optdepends=(
  'pipewire-jack: JACK audio backend'
  'jack2: JACK audio backend'
)
provides=("$pkgname")
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('72ab3804a1c0b1e5562d54a34b698baa90f259b8a8514962a25607bdc0887568')

build() {
  cd "$pkgname-$pkgver"
  export CARGO_HOME="$srcdir/cargo"
  cargo build --release --locked
}

package() {
  cd "$pkgname-$pkgver"

  install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 assets/hibiki.desktop \
    "$pkgdir/usr/share/applications/hibiki.desktop"
  install -Dm644 assets/hibiki.metainfo.xml \
    "$pkgdir/usr/share/metainfo/hibiki.metainfo.xml"
  install -Dm644 assets/hibiki.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/hibiki.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
